APP_ENV=development
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-pass>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-pass>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
